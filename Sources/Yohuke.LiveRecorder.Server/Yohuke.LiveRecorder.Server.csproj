<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
        <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <Content Remove="settings.json*;Data/**" />
        <None Remove="settings.json*;Data/**" />
        <Content Update="appsettings*.json">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Yohuke.LiveRecorder.Http.Tests" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12"/>
        <ProjectReference Include="../Layers/Yohuke.LiveRecorder.Infrastructure/Yohuke.LiveRecorder.Infrastructure.csproj" />
        <ProjectReference Include="../Modules/Yohuke.LiveRecorder.Media/Yohuke.LiveRecorder.Media.csproj" />
    </ItemGroup>

    <Target Name="BuildWebUI" BeforeTargets="IncludeWebUI" Condition="'$(BuildWebUI)' != 'false'">
        <Exec WorkingDirectory="../WebUI" Command="pnpm install --frozen-lockfile" />
        <Exec WorkingDirectory="../WebUI" Command="pnpm build" />
    </Target>
    <Target Name="IncludeWebUI" BeforeTargets="ComputeFilesToPublish">
        <ItemGroup>
            <_WebUiAsset Include="../WebUI/dist/**/*" />
            <ResolvedFileToPublish Include="@(_WebUiAsset)">
                <RelativePath>webui/%(_WebUiAsset.RecursiveDir)%(_WebUiAsset.Filename)%(_WebUiAsset.Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <Import Project="../../scripts/SingleFile.Publish.targets" />
</Project>
