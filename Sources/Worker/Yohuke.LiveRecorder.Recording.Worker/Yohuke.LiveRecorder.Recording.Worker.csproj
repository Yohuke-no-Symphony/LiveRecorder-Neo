<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ylr-rec-worker</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Yohuke.LiveRecorder.Worker.Common/Yohuke.LiveRecorder.Worker.Common.csproj" />
    <ProjectReference Include="../../Modules/Yohuke.LiveRecorder.Recording/Yohuke.LiveRecorder.Recording.csproj" />
    <ProjectReference Include="../../Modules/Yohuke.LiveRecorder.Recording.Contracts/Yohuke.LiveRecorder.Recording.Contracts.csproj" />
    <ProjectReference Include="../../Modules/Yohuke.LiveRecorder.Media/Yohuke.LiveRecorder.Media.csproj" />
    <InternalsVisibleTo Include="Yohuke.LiveRecorder.Recording.Worker.Tests" />
    <InternalsVisibleTo Include="Yohuke.LiveRecorder.Http.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="settings.json;settings.json.lock;settings.json.*.tmp" />
  </ItemGroup>
  <Import Project="../../../scripts/SingleFile.Publish.targets" />
</Project>
