<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ylr-tc-worker</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <ProjectReference Include="../Yohuke.LiveRecorder.Transcoding.Contracts/Yohuke.LiveRecorder.Transcoding.Contracts.csproj" />
    <ProjectReference Include="../Yohuke.LiveRecorder.Worker.Common/Yohuke.LiveRecorder.Worker.Common.csproj" />
    <InternalsVisibleTo Include="Yohuke.LiveRecorder.Transcoding.Worker.Tests" />
    <InternalsVisibleTo Include="Yohuke.LiveRecorder.Http.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="settings.json;settings.json.lock;settings.json.*.tmp" />
  </ItemGroup>
  <Import Project="../../scripts/SingleFile.Publish.targets" />
</Project>
